usecaseDiagram

actor "Guest" as G
actor "Member" as M
actor "Admin" as A

package "MariMatcha System" {
    usecase "View Landing Page" as UC1
    usecase "Browse Products" as UC2
    usecase "Search Products" as UC3
    usecase "Add to Cart" as UC4
    usecase "Checkout" as UC5
    usecase "Upload Payment Proof" as UC6
    usecase "View Invoice" as UC7
    
    usecase "Login / Register" as UC8
    usecase "Manage Profile" as UC9
    usecase "View Order History" as UC10
    usecase "Reorder" as UC11
    usecase "Submit Product Rating" as UC12
    
    usecase "Dashboard Monitoring" as UC13
    usecase "Manage Products" as UC14
    usecase "Manage Orders" as UC15
    usecase "Manage Users" as UC16
    usecase "View Sales Reports" as UC17
    usecase "Manage System Settings" as UC18
    
    usecase "Update Order Status" as UC19
    usecase "Confirm Payment" as UC20
}

%% Relationships for Guest
G --> UC1
G --> UC2
G --> UC3
G --> UC4
G --> UC5
G --> UC7
G --> UC8

%% Relationships for Member (Inherits from Guest capabilities usually, but let's be explicit)
M --> UC1
M --> UC2
M --> UC3
M --> UC4
M --> UC5
M --> UC7
M --> UC9
M --> UC10
M --> UC11
M --> UC12

%% Relationships for Admin
A --> UC13
A --> UC14
A --> UC15
A --> UC16
A --> UC17
A --> UC18

%% Include/Extend Relationships
UC5 ..> UC4 : <<include>>
UC6 ..> UC5 : <<extend>>
UC11 ..> UC4 : <<include>>
UC15 ..> UC19 : <<include>>
UC15 ..> UC20 : <<include>>

%% Actor Generalization (Optional but helpful)
M --|> G
